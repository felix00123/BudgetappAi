{
  "description": "Template for Azure App Registration used by Outlook sync. Do not put secrets here — pass the client id at build time.",
  "client_id": "YOUR_AZURE_APPLICATION_CLIENT_ID",
  "redirect_uri": "msauth.com.budgetappai.budgetapp://auth",
  "tenant": "consumers",
  "scopes": [
    "openid",
    "profile",
    "email",
    "offline_access",
    "https://graph.microsoft.com/User.Read",
    "https://graph.microsoft.com/Mail.Read"
  ],
  "run": "flutter run --dart-define=MICROSOFT_CLIENT_ID=YOUR_AZURE_APPLICATION_CLIENT_ID"
}
